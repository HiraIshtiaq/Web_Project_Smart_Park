@model Smart_Park_D2.Models.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "User Dashboard";
}
<div class="container py-4">
    <h4 class="mb-3">Welcome, @Model.CustomerName!</h4>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="card p-3 text-center">
                <p class="text-muted mb-1">Active Bookings</p>
                <h3>@Model.ActiveBookings</h3>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card p-3 text-center">
                <p class="text-muted mb-1">Total Bookings</p>
                <h3>@Model.TotalBookings</h3>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card p-3 text-center">
                <p class="text-muted mb-1">Total Spent</p>
                <h3>Rs. @Model.TotalSpent</h3>
            </div>
        </div>
    </div>
    <h5 id="parking" class="mb-3">Available Parking</h5>
    <div class="row g-3 mb-4">
        @foreach (var location in Model.ParkingLocations)
        {
            <div class="col-md-4">
                <div class="card p-3 h-100">
                    <h6>@location.Name</h6>
                    <p>@location.Address</p>
                    <p>Rs. @location.RatePerHour / hour</p>
                    <span class="badge bg-success">
                        @(location.TotalSlots - location.OccupiedSlots) Slots Free
                    </span>
                    <a href="#bookings" class="btn btn-primary btn-sm mt-3">
                        Book Now
                    </a>
                </div>
            </div>
        }
    </div>
    <h5 id="bookings" class="mb-3">My Bookings</h5>
    <partial name="_BookingTable" model="Model.Bookings" />

</div>
