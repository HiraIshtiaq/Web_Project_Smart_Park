@{
    ViewData["Title"] = "SmartPark";
}

<div class="text-white text-center py-5"
     style="background: linear-gradient(#0008,#0008), url('/images/backGroundImage.png') center/cover;">
    <div class="py-5">
        <h1>Parking Made Easy</h1>
        <p>Find and book your parking spot in a few clicks.</p>
        <a href="/Identity/Account/Register" class="btn btn-light">Sign up</a>
    </div>
</div>

<div class="container py-5">
    <h4 class="text-center mb-4">Our Features</h4>

    <div class="row g-3 text-center justify-content-center">
        <div class="col-md-4">
            <div class="card p-3 h-100">
                <h5>Find Parking</h5>
                <p class="mb-0">Find available parking slots.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 h-100">
                <h5>Book a Slot</h5>
                <p class="mb-0">Reserve your parking space.</p>
            </div>
        </div>
    </div>
</div>
